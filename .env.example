# Copia este archivo como .env y escribe tus valores. .env nunca se sube a Git.

# Django
# Genera una clave con: docker compose run --rm --no-deps backend python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del frontend que pueden llamar a la API (solo producción; separados por comas,
# p. ej. https://quien-toca.pages.dev). Ver docs/publicacion.md
CORS_ORIGENES_PERMITIDOS=
# Opcional: puertos en tu equipo si el 8000 o el 5173 están ocupados
# PUERTO_BACKEND=8001
# PUERTO_FRONTEND=5174

# PostgreSQL del contenedor local
POSTGRES_DB=quien_toca
POSTGRES_USER=quien_toca
POSTGRES_PASSWORD=

# Clave de la API Discovery: developer.ticketmaster.com > My Apps > Consumer Key
TICKETMASTER_API_KEY=
